# Origin the /api/* rewrite proxies to (see next.config.ts).
# Local development can leave this unset — it defaults to http://localhost:4000.
# In production this MUST point at the deployed backend, or every API call
# will be proxied to a localhost that doesn't exist there.
API_PROXY_TARGET=http://localhost:4000

# Base path the browser calls. Defaults to the same-origin "/api" rewrite,
# which keeps requests same-origin and keeps CORS out of the hot path.
# Only change this if you intend to call the backend directly.
NEXT_PUBLIC_API_URL=/api
